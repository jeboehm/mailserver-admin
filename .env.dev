# Settings of the dev environment in compose.yaml. Symfony loads this file only
# when APP_ENV=dev, so the test environment keeps the defaults CI runs with.
# The connection to the database and Redis comes from compose.yaml.

DEFAULT_URI=http://localhost:8000
MAILNAME=mail.example.com

# Dovecot's doveadm HTTP API; the certificate is the self-signed one in tls/.
DOVEADM_HTTP_URL=https://mda:8080
DOVEADM_API_KEY=doveadm
DOVEADM_VERIFY_SSL=false

RSPAMD_CONTROLLER_URL=http://filter:11334
RSPAMD_PASSWORD=rspamd

MCP_ENABLED=true
MCP_MAIL_READ_ENABLED=true
MCP_MAIL_SEND_ENABLED=true
