<div class="table-responsive">
    {# Fixed layout makes the column widths below authoritative. Without it the browser sizes
       columns to their content, and the unbreakable base64 of a DKIM key (~400 characters)
       stretches the table far beyond the viewport. #}
    <table class="table table-striped align-middle mb-0" style="table-layout: fixed">
        <thead>
        <tr>
            <th style="width: 20%">Name</th>
            <th style="width: 10%">Type</th>
            <th style="width: 22%">Expected</th>
            <th style="width: 22%">Actual</th>
            <th style="width: 10%">Status</th>
            <th style="width: 16%">Message</th>
        </tr>
        </thead>
        <tbody>
        {% for row in rows %}
            {% set status = row.status.value %}
            {% set badgeClass =
                status == 'ok' ? 'bg-success' :
                (status == 'warning' ? 'bg-warning text-dark' : 'bg-danger')
            %}
            <tr>
                <td class="text-break"><code>{{ row.subject }}</code></td>
                <td><span class="badge bg-secondary">{{ row.recordType }}</span></td>
                <td class="small text-break">
                    {% if row.expectedValues is empty %}
                        <span class="text-muted">—</span>
                    {% else %}
                        {{ row.expectedValues|map(value => value|e)|join('<br>')|raw }}
                    {% endif %}
                </td>
                <td class="small text-break">
                    {% if row.actualValues is empty %}
                        <span class="text-muted">—</span>
                    {% else %}
                        {{ row.actualValues|map(value => value|e)|join('<br>')|raw }}
                    {% endif %}
                </td>
                <td>
                    <span class="badge {{ badgeClass }}">{{ status|upper }}</span>
                </td>
                <td class="small">{{ row.message }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-muted">No checks available.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

