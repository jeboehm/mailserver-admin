parameters:
    level: 6
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    ignoreErrors:
        # Doctrine hydrates these entities, which PHPStan cannot see without an extension for it.
        # Not reported as unmatched, as composer run phpstan runs a level that does not raise them.
        -
            identifier: property.onlyRead
            path: src/Entity/MailboxCredential.php
            reportUnmatched: false
        -
            identifier: property.unusedType
            paths:
                - src/Entity/ApiToken.php
                - src/Entity/MailboxCredential.php
            reportUnmatched: false
